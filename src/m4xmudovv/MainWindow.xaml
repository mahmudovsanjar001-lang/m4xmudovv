<Window x:Class="m4xmudovv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        FontFamily="Segoe UI" Foreground="{DynamicResource PrimaryBrush}" Title="m4xmudovv" Width="1440" Height="900" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate x:Key="WallpaperCardTemplate">
            <Border Width="228" Height="176" Margin="0,0,12,12" Background="{DynamicResource Bg_111318}" BorderThickness="1" CornerRadius="10"
                    MouseLeftButtonUp="WallpaperCard_OnMouseLeftButtonUp" MouseEnter="WallpaperCard_OnMouseEnter" MouseLeave="WallpaperCard_OnMouseLeave">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Bd_22262E}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Bd_3E4655}" /></Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Bd_C9CED8}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border CornerRadius="9,9,0,0" Background="{DynamicResource Bg_090A0D}" />
                        <Border CornerRadius="9,9,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="9,9,0,0" Background="{DynamicResource Bg_151A23}" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding TypeLabel}" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Fg_9AA3B2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid x:Name="VideoHost" IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#A6000000" BorderBrush="#B3FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Video"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Border>
                            <Border Background="#A6000000" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#F5F7FA" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource CardMenuButton}" Content="&#x22EE;" AutomationProperties.Name="More actions" Click="CardMenu_OnClick" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCardTemplate">
            <Border Width="228" Height="176" Margin="0,0,12,12" Background="{DynamicResource Bg_111318}" BorderThickness="1" CornerRadius="10"
                    MouseLeftButtonUp="PlaylistCard_OnMouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Bd_22262E}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Bd_3E4655}" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border CornerRadius="9,9,0,0" Background="{DynamicResource Bg_090A0D}" />
                        <Border CornerRadius="9,9,0,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="9,9,0,0" Background="{DynamicResource Bg_151A23}" Visibility="{Binding Cover, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{DynamicResource Fg_9AA3B2}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Cover, Converter={StaticResource NullToVisibilityConverter}}" />
                        <Border Background="#A6000000" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="#F5F7FA" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="12,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource CardMenuButton}" Content="&#x22EE;" AutomationProperties.Name="Playlist actions" Click="PlaylistMenu_OnClick" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Bd_252A34}" BorderThickness="1" CornerRadius="14" Background="{DynamicResource CanvasBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource Bg_0E0F13}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" CornerRadius="14,0,0,14">
                <Grid Margin="14,0,14,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" Padding="12,52,0,34" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <TextBlock Text="M4XMUDOVV" FontSize="20" FontWeight="Bold" />
                    </Border>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavWallpapersButton" Style="{StaticResource NavButton}" Tag="Active" Height="42" Margin="0,0,0,6" Click="NavWallpapers_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="Wallpapers" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFavoritesButton" Style="{StaticResource NavButton}" Height="42" Margin="0,0,0,6" Click="NavFavorites_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="Favorites" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavPlaylistsButton" Style="{StaticResource NavButton}" Height="42" Margin="0,0,0,6" Click="NavPlaylists_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="Playlists" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Height="42" Margin="0,0,0,6" Click="NavSettings_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAboutButton" Style="{StaticResource NavButton}" Height="42" Click="NavAbout_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="17" Width="30" VerticalAlignment="Center" />
                                <TextBlock Text="About" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drag strip + window controls -->
            <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_OnClick" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_OnClick" />
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_OnClick" />
                </StackPanel>
            </Grid>

            <!-- Library -->
            <Grid x:Name="LibraryPage" Grid.Row="1" Grid.Column="1" Margin="22,8,10,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Bg_121418}" BorderBrush="{DynamicResource Bd_23262E}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Fg_C9CED8}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" Margin="48,0,12,0" TextChanged="SearchBox_OnTextChanged" />
                        <TextBlock Text="Search wallpapers…" FontSize="14" Foreground="{DynamicResource Fg_7D8796}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="52,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="CategoryAllButton" Style="{StaticResource ChipButton}" Tag="Active" Content="All" Click="Category_OnClick" />
                    <Button x:Name="CategoryImagesButton" Style="{StaticResource ChipButton}" Content="Images" Click="Category_OnClick" />
                    <Button x:Name="CategoryVideosButton" Style="{StaticResource ChipButton}" Content="Videos" Click="Category_OnClick" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,16,0,10">
                    <ScrollViewer x:Name="LibraryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Library_OnScrollChanged">
                        <ItemsControl x:Name="WallpaperItems" ItemTemplate="{StaticResource WallpaperCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="EmptyStatePanel" Background="{DynamicResource Bg_111419}" BorderBrush="{DynamicResource Bd_252B36}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <StackPanel>
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource Fg_C9D8FF}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitleText" Text="Your library is empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="EmptyStateMessageText" Text="Import an image or video to start building your wallpaper library." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,18" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="18,10" HorizontalAlignment="Center" Click="ImportMedia_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Import wallpaper" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- Import + details panel -->
            <Grid x:Name="DetailsPage" Grid.Row="1" Grid.Column="2" Margin="0,8,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="122" Height="48" Click="ImportMedia_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="Import" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource Bg_0F1115}" BorderBrush="{DynamicResource Bd_1E222A}" BorderThickness="1" CornerRadius="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- Preview -->
                            <Border Height="210" CornerRadius="10" Background="#050608">
                                <Grid x:Name="PreviewFrame">
                                    <Image x:Name="PreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                    <MediaElement x:Name="PreviewMedia" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Volume="0.3" Visibility="Collapsed" MediaOpened="PreviewMedia_OnMediaOpened" MediaFailed="PreviewMedia_OnMediaFailed" MediaEnded="PreviewMedia_OnMediaEnded" />
                                    <TextBlock x:Name="PreviewEmptyText" Text="Select a wallpaper to preview" Foreground="#727B8A" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16" />
                                    <Border x:Name="PreviewControls" VerticalAlignment="Bottom" Padding="8,22,12,8" Visibility="Collapsed">
                                        <!-- The video overlay always sits on a dark gradient, so its controls keep the dark palette in both themes. -->
                                        <Border.Resources>
                                        <SolidColorBrush x:Key="AccentBrush" Color="#DDE6FF" />
                                        <SolidColorBrush x:Key="Bd_1E222A" Color="#1E222A" />
                                        <SolidColorBrush x:Key="Bd_242832" Color="#242832" />
                                        <SolidColorBrush x:Key="Bd_3A4252" Color="#3A4252" />
                                        <SolidColorBrush x:Key="Bd_4A5465" Color="#4A5465" />
                                        <SolidColorBrush x:Key="Bg_14171C" Color="#14171C" />
                                        <SolidColorBrush x:Key="Bg_171A20" Color="#171A20" />
                                        <SolidColorBrush x:Key="Bg_1F232B" Color="#1F232B" />
                                        <SolidColorBrush x:Key="Bg_252A33" Color="#252A33" />
                                        <SolidColorBrush x:Key="Bg_2A2E37" Color="#2A2E37" />
                                        <SolidColorBrush x:Key="Bg_2A303B" Color="#2A303B" />
                                        <SolidColorBrush x:Key="Bg_343B47" Color="#343B47" />
                                        <SolidColorBrush x:Key="Fg_6B7280" Color="#6B7280" />
                                        <SolidColorBrush x:Key="Fg_E6E9EF" Color="#E6E9EF" />
                                        <SolidColorBrush x:Key="Fg_F5F7FA" Color="#F5F7FA" />
                                        <SolidColorBrush x:Key="Fg_FFFFFF" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="Fill_C9D8FF" Color="#C9D8FF" />
                                        <SolidColorBrush x:Key="Fill_F4F6FA" Color="#F4F6FA" />
                                        <SolidColorBrush x:Key="Fill_FFFFFF" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="Stroke_3E4655" Color="#3E4655" />
                                        <SolidColorBrush x:Key="Stroke_AFC8FF" Color="#AFC8FF" />
                                        </Border.Resources>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#CC000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource ChromeButton}" Width="32" Height="32" Click="PlayPause_OnClick">
                                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                            </Button>
                                            <Slider x:Name="TimelineSlider" Grid.Column="1" Minimum="0" Maximum="100" Background="#59FFFFFF" VerticalAlignment="Center" Margin="6,0,12,0" IsMoveToPointEnabled="True" PreviewMouseDown="Timeline_OnPreviewMouseDown" PreviewMouseUp="Timeline_OnPreviewMouseUp" ValueChanged="Timeline_OnValueChanged" />
                                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" Foreground="#F5F7FA" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Title -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedTitleText" Grid.Column="0" Text="No wallpaper selected" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button x:Name="DetailsFavoriteButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="&#xEB51;" FontSize="17" Width="36" Height="36" AutomationProperties.Name="Favorite" Click="DetailsFavorite_OnClick" />
                                <Button x:Name="DetailsMoreButton" Grid.Column="2" Style="{StaticResource ChromeButton}" Content="&#xE712;" FontSize="17" Width="36" Height="36" AutomationProperties.Name="More actions" Click="DetailsMore_OnClick" />
                            </Grid>
                            <TextBlock x:Name="SelectedTypeText" Text="Import a wallpaper to begin" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                            <!-- Actions -->
                            <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,18,0,0" Click="Apply_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Set as Wallpaper" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Height="46" Margin="0,10,0,0" Click="Play_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Volume -->
                            <Grid Margin="0,26,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Fg_C9CED8}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Volume" FontSize="13" Foreground="{DynamicResource Fg_E6E9EF}" VerticalAlignment="Center" />
                                <Slider x:Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0.3" VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="Volume_OnValueChanged" />
                                <TextBlock x:Name="VolumeText" Grid.Column="3" Text="30%" FontSize="13" Foreground="{DynamicResource Fg_E6E9EF}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Playback speed -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Fg_C9CED8}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Playback speed" FontSize="13" Foreground="{DynamicResource Fg_E6E9EF}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox x:Name="SpeedCombo" Grid.Column="2" SelectionChanged="Speed_OnSelectionChanged">
                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                    <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="2.0x" Tag="2.0" />
                                </ComboBox>
                            </Grid>

                            <!-- Fit mode -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Fg_C9CED8}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Fit mode" FontSize="13" Foreground="{DynamicResource Fg_E6E9EF}" VerticalAlignment="Center" />
                                <ComboBox x:Name="FitCombo" Grid.Column="2" SelectionChanged="Fit_OnSelectionChanged">
                                    <ComboBoxItem Content="Fill" Tag="Fill" IsSelected="True" />
                                    <ComboBoxItem Content="Fit" Tag="Fit" />
                                    <ComboBoxItem Content="Stretch" Tag="Stretch" />
                                    <ComboBoxItem Content="Center" Tag="Center" />
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource Bg_1E222A}" Margin="0,22,0,18" />

                            <!-- Details -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" FontSize="13" Foreground="{DynamicResource Fg_C9CED8}" Margin="0,0,0,14" />
                                <TextBlock x:Name="ResolutionText" Grid.Row="0" Grid.Column="1" Text="—" FontSize="13" Margin="0,0,0,14" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration" FontSize="13" Foreground="{DynamicResource Fg_C9CED8}" Margin="0,0,0,14" />
                                <TextBlock x:Name="DurationText" Grid.Row="1" Grid.Column="1" Text="—" FontSize="13" Margin="0,0,0,14" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="File size" FontSize="13" Foreground="{DynamicResource Fg_C9CED8}" Margin="0,0,0,14" />
                                <TextBlock x:Name="FileSizeText" Grid.Row="2" Grid.Column="1" Text="—" FontSize="13" Margin="0,0,0,14" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Path" FontSize="13" Foreground="{DynamicResource Fg_C9CED8}" />
                                <TextBlock x:Name="SelectedPathText" Grid.Row="3" Grid.Column="1" Text="—" FontSize="13" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Settings page (replaces the library + details panel while open) -->
            <!-- Favorites -->
            <Grid x:Name="FavoritesPage" Grid.Row="1" Grid.Column="1" Margin="22,8,10,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,2,0,0">
                    <TextBlock Text="Favorites" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="FavoritesSubtitleText" Text="Wallpapers you marked as favorites." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,10">
                    <ScrollViewer x:Name="FavoritesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Library_OnScrollChanged">
                        <ItemsControl x:Name="FavoriteItems" ItemTemplate="{StaticResource WallpaperCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border x:Name="FavoritesEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Bg_111419}" BorderBrush="{DynamicResource Bd_252B36}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <StackPanel>
                            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource Fg_C9D8FF}" HorizontalAlignment="Center" />
                            <TextBlock Text="No favorites yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="Open the ⋮ menu on any wallpaper and choose Add to Favorites. It will show up here." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,18" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="18,10" HorizontalAlignment="Center" Click="BrowseWallpapers_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Browse wallpapers" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Playlists: list of playlists, or the wallpapers of one opened playlist -->
            <Grid x:Name="PlaylistsPage" Grid.Row="1" Grid.Column="1" Margin="22,8,10,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="PlaylistListHeader" Grid.Column="0">
                        <TextBlock Text="Playlists" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlaylistsSubtitleText" Text="Collections of your wallpapers." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="PlaylistDetailHeader" Grid.Column="0" Visibility="Collapsed">
                        <Button Content="&#x2039;  Playlists" HorizontalAlignment="Left" Height="30" Padding="14,0" FontSize="12" Margin="0,0,0,8" Click="PlaylistBack_OnClick" />
                        <TextBlock x:Name="PlaylistTitleText" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlaylistDetailSubtitleText" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="NewPlaylistButton" Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0" Click="NewPlaylist_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="New playlist" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="PlaylistDetailActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="Rename" Height="40" Padding="18,0" Margin="0,0,8,0" Click="PlaylistRename_OnClick" />
                            <Button Content="Delete" Height="40" Padding="18,0" Click="PlaylistDelete_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,10">
                    <Grid x:Name="PlaylistListView">
                        <ScrollViewer x:Name="PlaylistsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PlaylistItems" ItemTemplate="{StaticResource PlaylistCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    <Border x:Name="PlaylistsEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Bg_111419}" BorderBrush="{DynamicResource Bd_252B36}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <StackPanel>
                            <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource Fg_C9D8FF}" HorizontalAlignment="Center" />
                            <TextBlock Text="No playlists yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="Create a playlist to group wallpapers, then add wallpapers from their ⋮ menu." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,18" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="18,10" HorizontalAlignment="Center" Click="NewPlaylist_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Create playlist" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid x:Name="PlaylistDetailView" Visibility="Collapsed">
                        <ScrollViewer x:Name="PlaylistDetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="Library_OnScrollChanged">
                            <ItemsControl x:Name="PlaylistWallpaperItems" ItemTemplate="{StaticResource WallpaperCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    <Border x:Name="PlaylistDetailEmptyPanel" Visibility="Collapsed" Background="{DynamicResource Bg_111419}" BorderBrush="{DynamicResource Bd_252B36}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <StackPanel>
                            <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource Fg_C9D8FF}" HorizontalAlignment="Center" />
                            <TextBlock Text="This playlist is empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="Open the ⋮ menu on a wallpaper, choose Add to Playlist and switch this playlist on." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status line shared by the Wallpapers / Favorites / Playlists pages -->
            <Grid x:Name="StatusBarPanel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Height="20" Margin="24,0,12,14" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" Text="Ready to preview" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,110,0" />
                <TextBlock x:Name="ItemCountText" Text="0 wallpapers" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
            </Grid>

            <Grid x:Name="SettingsPage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="22,8,16,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Changes are applied immediately and saved automatically." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                  <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,14,28">
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="General" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Start with Windows" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Launch m4xmudovv automatically when you sign in to Windows." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Start minimized to tray" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Open silently in the system tray instead of showing the window." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Start minimized to tray" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Minimize to tray when closing" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="The close button hides the window to the tray; use Exit in the tray menu to quit. A running video wallpaper keeps playing." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Minimize to tray when closing" IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Remember window size and position" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Reopen the window where you left it." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Remember window size and position" IsChecked="{Binding RememberWindowBounds, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Restore previous state" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Reopen with the wallpaper you last selected." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Restore previous state" IsChecked="{Binding RestoreAppState, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Apply wallpaper to lock screen" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Use the applied image on the Windows lock screen. Videos use their static thumbnail because Windows does not support video lock-screen backgrounds." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Apply wallpaper to lock screen" IsChecked="{Binding ApplyToLockScreen, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Performance" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Pause previews when minimized" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Stops the details preview while the window is minimized or hidden in the tray." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Pause previews when minimized" IsChecked="{Binding PausePreviewsWhenMinimized, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Pause previews when inactive" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Pauses the preview while another window has focus, and resumes it when you return." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Pause previews when inactive" IsChecked="{Binding PausePreviewsWhenInactive, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Video hover previews" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Play a muted preview inside a video card when you hover it." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Video hover previews" IsChecked="{Binding HoverPreviewEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Hover preview delay" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="How long to hover before a preview starts. Longer delays avoid accidental playback." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HoverPreviewEnabled}">
                                    <Slider Width="200" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="100" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Hover preview delay" Value="{Binding HoverDelayMs, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SettingsValue}" Width="68" TextAlignment="Right" Margin="12,0,0,0" Text="{Binding HoverDelayText}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Reduce background activity when idle" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="After 60 seconds in the background, minimized or hidden in the tray, pause the preview and release unused memory." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Reduce background activity when idle" IsChecked="{Binding ReduceBackgroundActivityWhenIdle, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Appearance" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Theme" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Dark is the default look. System default follows the Windows app mode." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center" AutomationProperties.Name="Theme" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="System default" />
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Playback" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Default preview volume" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Volume of the details preview. Changing it in the details panel is remembered too." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Width="200" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Default preview volume" Value="{Binding DefaultVolumePercent, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SettingsValue}" Width="68" TextAlignment="Right" Margin="12,0,0,0" Text="{Binding DefaultVolumeText}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Mute previews by default" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Previews start silent; moving the volume slider unmutes the current session." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Mute previews by default" IsChecked="{Binding MutePreviewsByDefault, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Sound for desktop video wallpapers" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Allow the current volume setting on the desktop wallpaper. Windows automatically mutes it while the PC is locked." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Sound for desktop video wallpapers" IsChecked="{Binding DesktopWallpaperSoundEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Default playback speed" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Speed of the details preview and of video wallpapers. Changes in the details panel are remembered." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center" AutomationProperties.Name="Default playback speed" SelectedValuePath="Tag" SelectedValue="{Binding DefaultSpeedTag, Mode=TwoWay}">
                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                    <ComboBoxItem Content="1.0x" Tag="1" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="2.0x" Tag="2" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Loop video previews" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Restart videos when they end (details preview and hover previews)." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Loop video previews" IsChecked="{Binding LoopVideoPreviews, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Library" />
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Remember last category" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Reopen on the category (All, Images or Videos) you last used." />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center" AutomationProperties.Name="Remember last category" IsChecked="{Binding RememberLastCategory, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Thumbnail quality" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Higher quality looks sharper but uses more disk space and memory. Thumbnails are rebuilt after a change." />
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="200" Height="38" VerticalAlignment="Center" AutomationProperties.Name="Thumbnail quality" SelectedIndex="{Binding ThumbnailQualityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Low (fastest)" />
                                    <ComboBoxItem Content="Balanced" />
                                    <ComboBoxItem Content="High (sharpest)" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Thumbnail cache" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="{Binding CacheInfoText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear thumbnail cache" Command="{Binding ClearCacheCommand}" Padding="18,0" Height="38" MinWidth="150" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="Wallpapers in library" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsValue}" TextAlignment="Right" MaxWidth="460" Text="{Binding LibraryCountText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- About (its own page, not part of Settings) -->
            <Grid x:Name="AboutPage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="22,8,16,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="About" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Version, system information, updates and licenses." FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                  <StackPanel MaxWidth="900" HorizontalAlignment="Left" Margin="0,0,14,28">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="Application" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsValue}" TextAlignment="Right" MaxWidth="460" Text="{Binding AppName}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="Version" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsValue}" TextAlignment="Right" MaxWidth="460" Text="{Binding VersionText}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="Windows architecture" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SettingsValue}" TextAlignment="Right" MaxWidth="460" Text="{Binding ArchitectureText}" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Check for updates" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="{Binding UpdateStatusText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Padding="18,0" Height="38" MinWidth="150" VerticalAlignment="Center" />
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <Grid Margin="20,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsTitle}" Text="Help &amp; support" />
                                    <TextBlock Style="{StaticResource SettingsDesc}" Text="Found a problem or have a question? Write to me directly." />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="SupportButton" Padding="18,0" Height="38" MinWidth="150" VerticalAlignment="Center"
                                        AutomationProperties.Name="Contact support by Gmail" ToolTip="Contact support" Click="Support_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Gmail logo, drawn as vector shapes -->
                                        <Viewbox Width="24" Height="18" Stretch="Uniform" VerticalAlignment="Center">
                                            <Canvas Width="48" Height="36">
                                                <Path Fill="#4285F4" Data="M0,6 C0,2 4.5,0 8,2.5 L8,36 L4,36 Q0,36 0,32 Z" />
                                                <Path Fill="#34A853" Data="M48,6 C48,2 43.5,0 40,2.5 L40,36 L44,36 Q48,36 48,32 Z" />
                                                <Path Fill="#FFFFFF" Data="M8,2.5 L24,14.5 L40,2.5 L40,36 L8,36 Z" />
                                                <Path Fill="#EA4335" Data="M8,2.5 L24,14.5 L40,2.5 L40,11 L24,23 L8,11 Z" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Contact support" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <StackPanel Margin="20,14">
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="License" />
                                <TextBlock Style="{StaticResource SettingsDesc}" Text="{Binding LicenseText}" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsDivider}" />
                            <StackPanel Margin="20,14">
                                <TextBlock Style="{StaticResource SettingsTitle}" Text="Third-party acknowledgements" />
                                <TextBlock Style="{StaticResource SettingsDesc}" Text="{Binding AcknowledgementsText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
